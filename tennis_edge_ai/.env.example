# Copy to .env and fill in. Never commit .env.
# ---- Storage (defaults shown) ----
# TE_DB_PATH=var/tennis_edge.db
# TE_ARTIFACTS_DIR=var/artifacts
# TE_SACKMANN_DIR=..            # folder containing atp/ and wta/ (this repository root)

# ---- History scope ----
TE_HISTORY_START_YEAR=2000
TE_INCLUDE_CHALLENGERS=true
TE_INCLUDE_ITF=true
TE_INCLUDE_FUTURES=false

# ---- Validation ----
TE_FIRST_TEST_YEAR=2019
TE_TRAIN_WINDOW_YEARS=10

# ---- Bet filter ----
TE_MIN_EDGE=0.02
TE_MAX_DATA_AGE_DAYS=120
TE_MIN_SAMPLE_MATCHES=8
TE_KELLY_FRACTION=0.25

# ---- Automation ----
TE_REFRESH_MINUTES=30
TE_GRADE_MINUTES=60
TE_ALERT_LINE_MOVE=1.0
# TE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   (optional, your own webhook)

# ---- Optional licensed data providers ----
# The Odds API (https://the-odds-api.com) - sportsbook tennis h2h/totals odds. Free tier key works.
# ODDS_API_KEY=
# ODDS_API_REGIONS=us
# PrizePicks: there is no public developer API. Only fill these if you hold a written data licence
# from PrizePicks or a licensed reseller that supplies JSON in the documented schema (see README).
# PRIZEPICKS_LICENSED_API_URL=
# PRIZEPICKS_LICENSED_API_KEY=
# Tailgate: only if you have authorised API access.
# TAILGATE_API_URL=
# TAILGATE_API_KEY=

# ---- FastAPI ----
# TE_API_TOKEN=change-me      # required as 'X-API-Token' header when set
